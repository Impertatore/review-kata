# Copy to .env and fill in. Never commit .env.
# Run with: node --env-file=.env <entry>

# Payment provider credential. Use a sandbox/test key for local development —
# a live key does not belong on a developer machine.
PAYMENTS_API_KEY=

# Optional. Defaults to the production endpoint when unset; point it at a
# sandbox to exercise the charge path locally.
PAYMENTS_URL=
